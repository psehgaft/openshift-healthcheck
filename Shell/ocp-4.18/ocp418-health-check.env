# =============================================================================
# OpenShift 4.18+ Health Check - Environment Variables Example
# Copy this file to .ocp-health-check.env, edit values, and run:
# ./ocp418-health-check-html.sh --env-file ./.ocp-health-check.env
# =============================================================================

# Human-friendly label used only for local report/output folder names.
CLUSTER_NAME_HINT="prod-ocp-qro"

# Minimum OpenShift minor version expected by this script.
OCP_MIN_MINOR="18"

# Base folder for health check executions.
OUTPUT_BASE_DIR="/tmp/ocp-health"

# Optional fixed output directory. Leave empty to auto-generate a timestamped folder.
OUT_DIR=""

# Timeout per command in seconds. Increase for very large clusters.
TIMEOUT_SECONDS="180"

# Pause after each major validation step.
PAUSE="false"

# Collect additional describe and core operator log tails.
DEEP="false"

# Run oc adm must-gather at the end. Heavy; enable mainly for support cases.
RUN_MUST_GATHER="false"

# Collect logs from problematic pods detected by the script.
COLLECT_PROBLEM_POD_LOGS="true"

# Collect selected core operator logs only when DEEP=true.
COLLECT_CORE_OPERATOR_LOGS="true"

# Number of log lines to collect per pod/operator.
LOG_TAIL_LINES="250"

# Maximum number of problematic pods for logs/describe output.
MAX_PROBLEM_PODS="25"

# Flag pods whose containers restarted above this threshold.
RESTART_THRESHOLD="10"

# Query active platform alerts through the Kubernetes API proxy to Prometheus.
RUN_PROMETHEUS_ALERTS="true"

# Number of recent Warning events to keep in the evidence bundle.
EVENT_LIMIT="250"

# Core namespaces to snapshot. Space-separated list inside quotes.
CORE_NAMESPACES="openshift-kube-apiserver openshift-apiserver openshift-etcd openshift-authentication openshift-ingress openshift-ingress-operator openshift-dns openshift-network-operator openshift-monitoring openshift-console openshift-machine-config-operator openshift-operator-lifecycle-manager"

# Report title.
REPORT_TITLE="OpenShift 4.18+ General Health Report"
