# OpenShift 4.18+ Health Check CER Collector variables
# Copy this file to .ocp-healthcheck.env and adjust the values.

# Identification
CLUSTER_NAME_HINT="prod-ocp"
ENGAGEMENT_NAME="OpenShift Health Check"

# Output location
OUTPUT_BASE_DIR="./ocp-healthcheck-runs"

# Version baseline
MIN_OCP_VERSION="4.18"
STOP_ON_VERSION_BELOW_MIN="true"

# Collection behavior
TIMEOUT_SECONDS="180"
DEEP="false"
RUN_MUST_GATHER="false"
COLLECT_PROBLEM_POD_LOGS="true"
LOG_TAIL_LINES="300"
MAX_PROBLEM_PODS="40"
RESTART_THRESHOLD="10"
RUN_PROMETHEUS_ALERTS="true"
EVENT_LIMIT="500"

# Optional Red Hat capability checks
COLLECT_OPENSHIFT_VIRTUALIZATION="true"
COLLECT_ODF="true"
COLLECT_ACM="true"
COLLECT_ACS="true"
COLLECT_GITOPS_PIPELINES="true"
COLLECT_NAMESPACED_WORKLOADS="true"

# Keep false unless explicitly needed. The collector is read-only by default and avoids node debug.
COLLECT_NODE_DEBUG="false"

# CER repository integration. Default is local output only.
WRITE_CER_ITEMS_TO_REPO="false"
CER_REPO_ROOT=""

# Delivery sanitization.
# Raw command evidence remains exact for technical review. Generated reports and item text can be sanitized.
SANITIZE_DELIVERY_OUTPUT="true"
REDACTION_PATTERNS_FILE="./redaction-patterns.txt"

# Package generation
CREATE_PACKAGES="true"
